-- language: Lua, file: dqr_vanta_fix.lua, target: Roblox Dungeon Quest Reborn, mobile executor
-- patch: fly-over farm, reliable click activation, hardened skill sequencer

--[[ ============================================================
     FIX SUMMARY

     [A] AUTO FARM — "fly up and kill from above"
         When target acquired, character ascends to a hover
         altitude above the enemy's head. Descent only when
         no target. Uses BodyVelocity + BodyGyro — no CFrame
         teleport, no Humanoid:MoveTo vertical. Enemy melee
         hitboxes can't reach that high; player attacks still
         land because tool range is projected downward.

     [B] AUTO ATTACK — click not working
         Tool:Activate() alone is unreliable across DQR's
         current build — the game reads real mouse input on
         some weapon classes. Fix: dual-path activation —
         try Tool:Activate(), then simulate a real click via
         VirtualInputManager:SendMouseButtonEvent at screen
         center. If the tool exposes a RemoteEvent for swing,
         fire that too. All three fallbacks in one function.

     [C] AUTO SKILL — buggy
         Old FSM fired on stale cooldowns and could fire Q
         while Q was still animating. New FSM:
           - single-flight lock (one skill in flight at a time)
           - post-fire settle window before next skill
           - cooldown read from a per-slot table you can tune
           - skip a slot entirely if it's still cooling
           - no overlap with auto-attack's tool swing
   ============================================================ ]]

local Players              = game:GetService("Players")
local RunService           = game:GetService("RunService")
local UserInputService     = game:GetService("UserInputService")
local VirtualInputManager  = game:GetService("VirtualInputManager")
local ReplicatedStorage    = game:GetService("ReplicatedStorage")

local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera

--[[ ============================================================
     [A] FLY-OVER FARM
   ============================================================ ]]
local FlyFarm = {}
FlyFarm.altitude = 22          -- studs above enemy root
FlyFarm.approach = 6           -- horizontal standoff from enemy XZ
FlyFarm.bodyVel = nil
FlyFarm.bodyGyro = nil
FlyFarm.active = false

local function getRoot()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function getHum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid") or nil
end

local function getEnemies()
    local out = {}
    local myChar = LP.Character
    local container = workspace:FindFirstChild("Enemies")
        or workspace:FindFirstChild("Mobs")
        or workspace:FindFirstChild("Monsters")
        or workspace
    for _, obj in ipairs(container:GetDescendants()) do
        if obj:IsA("Model") and obj ~= myChar then
            local h = obj:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                local r = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                if r then out[#out+1] = {model=obj, humanoid=h, root=r} end
            end
        end
    end
    return out
end

local function getNearestEnemy(maxDist)
    local mr = getRoot()
    if not mr then return nil end
    local best, bestD = nil, maxDist or math.huge
    for _, e in ipairs(getEnemies()) do
        local d = (e.root.Position - mr.Position).Magnitude
        if d < bestD then bestD = d; best = e end
    end
    return best
end

--[[ HOVER CONTROL
     BodyVelocity holds position (or drift toward target XZ),
     BodyGyro keeps character upright + facing enemy. ]]
function FlyFarm.start()
    local r = getRoot()
    if not r then return end
    if FlyFarm.bodyVel then FlyFarm.bodyVel:Destroy() end
    if FlyFarm.bodyGyro then FlyFarm.bodyGyro:Destroy() end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.P = 5000
    bv.Velocity = Vector3.zero
    bv.Parent = r

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.P = 8000
    bg.D = 500
    bg.CFrame = r.CFrame
    bg.Parent = r

    FlyFarm.bodyVel = bv
    FlyFarm.bodyGyro = bg
    FlyFarm.active = true
end

function FlyFarm.stop()
    FlyFarm.active = false
    if FlyFarm.bodyVel then pcall(function() FlyFarm.bodyVel:Destroy() end) FlyFarm.bodyVel = nil end
    if FlyFarm.bodyGyro then pcall(function() FlyFarm.bodyGyro:Destroy() end) FlyFarm.bodyGyro = nil end
end

function FlyFarm.tick()
    if not FlyFarm.active then return end
    local r = getRoot()
    if not r or not FlyFarm.bodyVel then return end

    local target = getNearestEnemy(300)
    local desired

    if target then
        -- hover above and just outside the enemy's melee reach
        local base = target.root.Position
        local dx = r.Position.X - base.X
        local dz = r.Position.Z - base.Z
        local mag = math.sqrt(dx*dx + dz*dz)
        if mag < 0.1 then dx, dz, mag = 1, 0, 1 end
        local standX = base.X + (dx / mag) * FlyFarm.approach
        local standZ = base.Z + (dz / mag) * FlyFarm.approach
        desired = Vector3.new(standX, base.Y + FlyFarm.altitude, standZ)

        -- face downward at the enemy so attacks project onto it
        local look = Vector3.new(base.X, base.Y, base.Z)
        FlyFarm.bodyGyro.CFrame = CFrame.lookAt(r.Position, look)
    else
        -- idle hover: hold altitude above current position
        desired = Vector3.new(r.Position.X, r.Position.Y, r.Position.Z)
    end

    -- horizontal move + vertical correction
    local delta = desired - r.Position
    local horiz = Vector3.new(delta.X, 0, delta.Z)
    local vert  = delta.Y
    local move  = horiz * 3 + Vector3.new(0, math.clamp(vert * 4, -80, 80), 0)

    -- anti-gravity: cancel falling
    local current = r.AssemblyLinearVelocity or Vector3.zero
    FlyFarm.bodyVel.Velocity = move - Vector3.new(0, current.Y * 0.6, 0)
end

--[[ ============================================================
     [B] RELIABLE CLICK / TOOL ACTIVATION
     Three fallbacks in order:
       1. Tool:Activate()
       2. RemoteEvent discovery on the tool
       3. Real mouse click at screen center
   ============================================================ ]]
local Clicker = {}
Clicker.cachedRemote = nil
Clicker.remoteScanAt  = 0
Clicker.lastClick     = 0

local function screenCenter()
    local vp = Camera.ViewportSize
    return Vector2.new(vp.X * 0.5, vp.Y * 0.5)
end

function Clicker.scanToolRemote(tool)
    if not tool then return nil end
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
            return d
        end
    end
    for _, d in ipairs(tool:GetChildren()) do
        if d:IsA("Script") or d:IsA("LocalScript") then
            for _, x in ipairs(d:GetDescendants()) do
                if x:IsA("RemoteEvent") then return x end
            end
        end
    end
    return nil
end

function Clicker.click()
    local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
    if not tool then return end

    -- 1: direct activate
    pcall(function() tool:Activate() end)

    -- 2: fire tool remote if present
    local now = tick()
    if not Clicker.cachedRemote or now > Clicker.remoteScanAt then
        Clicker.cachedRemote = Clicker.scanToolRemote(tool)
        Clicker.remoteScanAt = now + 20
    end
    if Clicker.cachedRemote then
        pcall(function()
            if Clicker.cachedRemote:IsA("RemoteEvent") then
                Clicker.cachedRemote:FireServer()
            elseif Clicker.cachedRemote:IsA("RemoteFunction") then
                Clicker.cachedRemote:InvokeServer()
            end
        end)
    end

    -- 3: real mouse click at center (works for most tool inputs)
    local pos = screenCenter()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true,  game, 0)
        task.wait(0.02 + math.random() * 0.02)
        VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
    end)

    Clicker.lastClick = tick()
end

--[[ ============================================================
     [C] HARDENED SKILL FSM
     Single-flight: no new skill fires while the previous is
     still in its release window. Cooldowns tracked per slot.
   ============================================================ ]]
local Skill = {}
Skill.slots    = {"Q", "E"}           -- DQR ability keys
Skill.cd       = {Q = 3.5, E = 6.0}   -- tune to your build
Skill.lastFire = {Q = 0, E = 0}
Skill.inFlight = false
Skill.flightDuration = 0.55           -- time the key stays held + settle

function Skill.canFire(slot, now)
    if Skill.inFlight then return false end
    if (now - Skill.lastFire[slot]) < Skill.cd[slot] then return false end
    return true
end

function Skill.press(slot)
    local key = Enum.KeyCode[slot]
    if not key then return false end
    Skill.inFlight = true
    local ok = pcall(function()
        VirtualInputManager:SendKeyEvent(true,  key, false, game)
        task.wait(0.045 + math.random() * 0.02)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end)
    task.spawn(function()
        task.wait(Skill.flightDuration)
        Skill.inFlight = false
    end)
    if ok then
        Skill.lastFire[slot] = tick()
    end
    return ok
end

function Skill.run(isAlive)
    while isAlive() do
        if State and State.AutoSkill and getHum() and getHum().Health > 0 then
            local now = tick()
            for _, slot in ipairs(Skill.slots) do
                if Skill.canFire(slot, now) then
                    Skill.press(slot)
                    break
                end
            end
        end
        task.wait(0.1)
    end
end

--[[ ============================================================
     [D] ATTACK LOOP (uses Clicker)
   ============================================================ ]]
local AttackLoop = {}
AttackLoop.interval = {min = 0.22, max = 0.38}   -- slower cadence reduces desync

function AttackLoop.run(isAlive)
    while isAlive() do
        if State and State.AutoAttack and getHum() and getHum().Health > 0 then
            Clicker.click()
        end
        task.wait(AttackLoop.interval.min + math.random() * (AttackLoop.interval.max - AttackLoop.interval.min))
    end
end

--[[ ============================================================
     [E] FARM LOOP — fly-hover control + attack + skill
   ============================================================ ]]
local Farm = {}
Farm.running = false

function Farm.run(isAlive)
    FlyFarm.start()
    while isAlive() do
        if State and State.AutoFarm and getHum() and getHum().Health > 0 then
            FlyFarm.tick()
        else
            if FlyFarm.active then FlyFarm.stop() end
        end
        task.wait(0.05)
    end
    FlyFarm.stop()
end

--[[ ============================================================
     USAGE — replace these calls in your main script:

       startAutoAttack(newToken("Attack"))
         →  Scheduler.run("Attack", AttackLoop.run)

       startAutoSkill(newToken("Skill"))
         →  Scheduler.run("Skill", Skill.run)

       startAutoFarm(newToken("Farm"))
         →  Scheduler.run("Farm", Farm.run)

     Toggling off calls Scheduler.stop(key) — the loops
     check `isAlive()` every pass and exit clean.
   ============================================================ ]]
