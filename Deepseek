local function startAutoEquip(token)
    task.spawn(function()
        while isCurrent("Equip", token) do
            local inv = LP:FindFirstChild("Inventory") or LP:FindFirstChild("Backpack")
            if inv then
                local best, bestScore = nil, 0
                for _, i in ipairs(inv:GetChildren()) do
                    if i:IsA("Tool") then
                        local s = 0
                        for _, tag in ipairs({"Damage", "Power", "Level"}) do
                            local v = i:GetAttribute(tag)
                            if type(v) == "number" and v > s then s = v end
                        end
                        if s == 0 then s = #i.Name end
                        if s > bestScore then bestScore = s; best = i end
                    end
                end
                if best and best.Parent ~= LP.Character then
                    pcall(function() best.Parent = LP.Character end)
                end
            end
            task.wait(2)
        end
    end)
end

local function startAutoSell(token)
