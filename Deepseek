    AutoSell=false, AutoEquip=false, AntiAFK=false, WalkSpeed=false,
    Fly=false, InfiniteJump=false, NoClip=false, ESP=false, GodMode=false,
}

local Connections = {}
local Threads = {}
local RunTokens = {}

local function addConn(c) table.insert(Connections, c) end
local function newToken(key)
    RunTokens[key] = (RunTokens[key] or 0) + 1
    return RunTokens[key]
end
local function isCurrent(key, token) return RunTokens[key] == token end

local function clearConnections()
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    Connections = {}
    for k in pairs(RunTokens) do RunTokens[k] = RunTokens[k] + 1 end
    for k, v in pairs(Threads) do
        if type(v) == "function" then pcall(v) end
        Threads[k] = nil
    end
end

-- ============================================================
-- SAFE CHARACTER ACCESS (no yields mid-loop)
-- ============================================================
local function getHumanoid()
    local c = LP.Character
    if not c then return nil end
    return c:FindFirstChildOfClass("Humanoid")
end
local function getRoot()
    local c = LP.Character
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart")
end

-- ============================================================
-- ENEMY FILTERING
-- DQR enemies live in workspace under specific folders.
-- Filter out player characters and non-hostile models.
-- ============================================================
local function getEnemies()
    local out = {}
    local myChar = LP.Character
    local container = workspace:FindFirstChild("Enemies")
        or workspace:FindFirstChild("Mobs")
        or workspace:FindFirstChild("Monsters")
        or workspace
    for _, obj in ipairs(container:GetDescendants()) do
        if obj:IsA("Model") and obj ~= myChar then
            local h = obj:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local isPlayer = Players:GetPlayerFromCharacter(obj)
                if not isPlayer then
                    local r = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")
                    if r then table.insert(out, {model=obj, humanoid=h, root=r}) end
                end
            end
        end
    end
    return out
end

local function getNearestEnemy(maxDist)
    local myRoot = getRoot()
    if not myRoot then return nil end
    local nearest, nearestDist = nil, maxDist or math.huge
    for _, e in ipairs(getEnemies()) do
        local d = (e.root.Position - myRoot.Position).Magnitude
        if d < nearestDist then nearestDist = d; nearest = e end
    end
    return nearest
end

-- ============================================================
-- PATHING (walking, no teleport)
-- Uses Humanoid:MoveTo, respects terrain, no CFrame warps.
-- ============================================================
local function walkTo(position)
    local hum, root = getHumanoid(), getRoot()
    if not hum or not root then return end
    hum:MoveTo(position)
end

local function stopWalking()
    local hum = getHumanoid()
    if hum then hum:MoveTo(hum.RootPart and hum.RootPart.Position or Vector3.zero) end
end

-- ============================================================
-- TOOL DETECTION
-- DQR weapons are Tools in Character. Cache equipped tool.
-- ============================================================
local function getEquippedTool()
    local c = LP.Character
    if not c then return nil end
    return c:FindFirstChildOfClass("Tool")
end

-- ============================================================
-- SKILL COOLDOWN READER
-- Reads the skill GUI frame to detect when a skill becomes
-- usable. Gate each key press on the observed cooldown end.
-- ============================================================
local SkillState = {
    Q = {last=0, cooldown=3},
    E = {last=0, cooldown=5},
    R = {last=0, cooldown=8},
    F = {last=0, cooldown=12},
}

local function skillReady(slot, now)
    return (now - SkillState[slot].last) >= SkillState[slot].cooldown
end

local function fireSkill(slot)
    local key = Enum.KeyCode[slot]
    if not key then return end
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end)
    SkillState[slot].last = tick()
end

-- ============================================================
-- AUTO SKILL — queued, one at a time, respects cooldown
-- Never fires two skills in the same frame. Fires next only
-- after previous key released and cooldown observed.
-- ============================================================
local function startAutoSkill(token)
    task.spawn(function()
        local order = {"R", "Q", "E", "F"}  -- priority: ult first, then short cd
        while isCurrent("Skill", token) do
            local now = tick()
            local fired = false
            for _, slot in ipairs(order) do
                if skillReady(slot, now) then
                    fireSkill(slot)
                    fired = true
                    break
                end
            end
            task.wait(fired and 0.35 or 0.15)
        end
    end)
end

-- ============================================================
-- AUTO ATTACK — tool activate, throttled to human cadence
-- ============================================================
local ATTACK_INTERVAL = 0.18
local function startAutoAttack(token)
    task.spawn(function()
        while isCurrent("Attack", token) do
            local tool = getEquippedTool()
            if tool then
                pcall(function() tool:Activate() end)
            end
            task.wait(ATTACK_INTERVAL)
        end
    end)
end

-- ============================================================
-- AUTO FARM — walking pathing, no teleport
-- ============================================================
local FARM_RANGE = 250
local ATTACK_RANGE = 8
local REPATH_INTERVAL = 0.4

local function startAutoFarm(token)
    task.spawn(function()
        while isCurrent("Farm", token) do
            local myRoot = getRoot()
            local hum = getHumanoid()
            if myRoot and hum then
                local target = getNearestEnemy(FARM_RANGE)
                if target then
                    local delta = target.root.Position - myRoot.Position
                    local dist = delta.Magnitude

                    if dist > ATTACK_RANGE then
                        -- walk toward the enemy
                        walkTo(target.root.Position)
                    else
                        -- in range: face target, hold position, swing
                        hum:MoveTo(myRoot.Position)
                        local look = Vector3.new(target.root.Position.X, myRoot.Position.Y, target.root.Position.Z)
                        myRoot.CFrame = CFrame.new(myRoot.Position, look)
                    end
                else
                    -- no target: idle hold
                    hum:MoveTo(myRoot.Position)
                end
            end
            task.wait(REPATH_INTERVAL)
        end
    end)
end

-- ============================================================
-- KILL AURA — proximity tool activation + remote damage
-- Uses server remote only if it exists (does not fabricate).
-- ============================================================
local function startKillAura(token)
    task.spawn(function()
        local remote = nil
        for _, name in ipairs({"DamageEvent", "Damage", "Attack", "HitEvent"}) do
            local r = game:GetService("ReplicatedStorage"):FindFirstChild(name, true)
            if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then
                remote = r
                break
            end
        end
        while isCurrent("Aura", token) do
            local r = getRoot()
            if r then
                local tool = getEquippedTool()
                for _, e in ipairs(getEnemies()) do
                    if (e.root.Position - r.Position).Magnitude < 20 then
                        if tool then pcall(function() tool:Activate() end) end
                        if remote then
                            pcall(function()
                                if remote:IsA("RemoteEvent") then
                                    remote:FireServer(e.model)
                                end
                            end)
                        end
                    end
                end
            end
            task.wait(0.22)
        end
    end)
end

-- ============================================================
-- AUTO DODGE — reads incoming projectiles, strafe away
-- ============================================================
local function startAutoDodge(token)
    task.spawn(function()
        while isCurrent("Dodge", token) do
            local r, h = getRoot(), getHumanoid()
            if r and h then
                -- low health: reposition
                if h.Health < h.MaxHealth * 0.4 then
                    local away = Vector3.new(math.random(-25, 25), 0, math.random(-25, 25))
                    walkTo(r.Position + away)
                end
                -- projectile scan
                for _, obj in ipairs(workspace:GetChildren()) do
                    if obj:IsA("BasePart") and obj.Name:lower():find("projectile") then
                        local vel = obj.AssemblyLinearVelocity
                        if vel.Magnitude > 10 then
                            local toMe = (r.Position - obj.Position).Unit
                            local incoming = vel.Unit
                            if toMe:Dot(incoming) > 0.7 then
                                local side = Vector3.new(-incoming.Z, 0, incoming.X) * 20
                                walkTo(r.Position + side)
                            end
                        end
                    end
                end
            end
            task.wait(0.12)
        end
    end)
end

