-- ESP
-- ============================================================
local espCache = {}
local function enableESP(token)
    addConn(RunService.RenderStepped:Connect(function()
        if not isCurrent("ESP", token) then return end
        for _, e in ipairs(getEnemies()) do
            if not espCache[e.model] or not espCache[e.model].billboard.Parent then
                local bb = Instance.new("BillboardGui", e.model)
                bb.Size = UDim2.new(0, 100, 0, 30)
                bb.StudsOffset = Vector3.new(0, 3, 0)
                bb.AlwaysOnTop = true
                local lbl = Instance.new("TextLabel", bb)
                lbl.Size = UDim2.new(1, 0, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.Text = e.model.Name
                lbl.TextColor3 = Color3.fromRGB(255, 80, 80)
                lbl.TextSize = 11
                lbl.Font = Enum.Font.GothamBold
                lbl.TextStrokeTransparency = 0
                local hl = Instance.new("Highlight", e.model)
                hl.FillColor = Color3.fromRGB(255, 60, 60)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.7
                espCache[e.model] = {billboard=bb, highlight=hl}
            else
                local data = espCache[e.model]
                local lbl = data.billboard:FindFirstChildOfClass("TextLabel")
                if lbl then lbl.Text = e.model.Name .. " [" .. math.floor(e.humanoid.Health) .. "]" end
            end
        end
    end))
end

local function clearESP()
    for _, d in pairs(espCache) do
        pcall(function() d.billboard:Destroy() end)
        pcall(function() d.highlight:Destroy() end)
    end
    espCache = {}
end

local function enableGodMode(token)
    addConn(RunService.Heartbeat:Connect(function()
