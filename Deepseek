local State = {
    AutoFarm=false, AutoAttack=false, AutoSkill=false, KillAura=false,
    AutoDodge=false, AutoStart=false, AutoReplay=false, AutoBackLobby=false,
    AutoSell=false, AutoEquip=false, AntiAFK=false, WalkSpeed=false,
    Fly=false, InfiniteJump=false, NoClip=false, ESP=false, GodMode=false,
}

local Connections = {}
local Threads = {}

local function addConn(c) table.insert(Connections, c) end
local function clearConnections()
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    Connections = {}
end

local function getCharacter() return LP.Character or LP.CharacterAdded:Wait() end
local function getHumanoid()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid") or nil
end
local function getRoot()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function getEnemies()
    local out = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LP.Character then
            local h = obj:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local r = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                if r then table.insert(out, {model=obj, humanoid=h, root=r}) end
            end
        end
    end
    return out
end

local function getNearestEnemy(maxDist)
    local myRoot = getRoot()
    if not myRoot then return nil end
    local nearest, nearestDist = nil, maxDist or math.huge
    for _, e in ipairs(getEnemies()) do
        local d = (e.root.Position - myRoot.Position).Magnitude
        if d < nearestDist then nearestDist = d; nearest = e end
    end
    return nearest
end

local function applyWalkSpeed(s)
    local h = getHumanoid()
    if h then h.WalkSpeed = s end
end

local function enableAntiAFK()
    addConn(LP.Idled:Connect(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end))
end

local function enableInfiniteJump()
    addConn(UserInputService.JumpRequest:Connect(function()
        local h = getHumanoid()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end))
end

local function enableNoClip()
    addConn(RunService.Stepped:Connect(function()
        local c = LP.Character
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end))
end

local function enableFly()
    local root, hum = getRoot(), getHumanoid()
    if not root or not hum then return end
    local bv = Instance.new("BodyVelocity", root)
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    local bg = Instance.new("BodyGyro", root)
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.P = 1e4
    addConn(RunService.RenderStepped:Connect(function()
        local move = Vector3.zero
        local cam = Camera.CFrame
        local gp = UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)
        if gp then
            for _, i in ipairs(gp) do
                if i.KeyCode == Enum.KeyCode.Thumbstick1 then
                    move = move + cam.LookVector * i.Position.Z * 80
                    move = move + cam.RightVector * i.Position.X * 80
                end
            end
        end
        bv.Velocity = move
        bg.CFrame = cam
    end))
    Threads.FlyCleanup = function()
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
    end
end

local function teleportToNearest()
    local t = getNearestEnemy(9999)
    local r = getRoot()
    if t and r then r.CFrame = t.root.CFrame + Vector3.new(0, 3, 0) end
end

local espCache = {}
local function enableESP()
    addConn(RunService.RenderStepped:Connect(function()
        for _, e in ipairs(getEnemies()) do
            if not espCache[e.model] then
                local bb = Instance.new("BillboardGui", e.model)
                bb.Size = UDim2.new(0, 100, 0, 30)
                bb.StudsOffset = Vector3.new(0, 3, 0)
                bb.AlwaysOnTop = true
                local lbl = Instance.new("TextLabel", bb)
                lbl.Size = UDim2.new(1, 0, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.Text = e.model.Name .. " [" .. math.floor(e.humanoid.Health) .. "]"
                lbl.TextColor3 = Color3.fromRGB(255, 80, 80)
                lbl.TextSize = 11
                lbl.Font = Enum.Font.GothamBold
                lbl.TextStrokeTransparency = 0
                local hl = Instance.new("Highlight", e.model)
                hl.FillColor = Color3.fromRGB(255, 60, 60)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.7
                espCache[e.model] = {billboard=bb, highlight=hl}
            else
                local data = espCache[e.model]
                if data and data.billboard then
                    local lbl = data.billboard:FindFirstChildOfClass("TextLabel")
                    if lbl then lbl.Text = e.model.Name .. " [" .. math.floor(e.humanoid.Health) .. "]" end
                end
            end
        end
    end))
end

local function enableGodMode()
    addConn(RunService.Heartbeat:Connect(function()
        local h = getHumanoid()
        if h then h.MaxHealth = math.huge; h.Health = math.huge end
    end))
end

local function startAutoAttack()
    addConn(RunService.Heartbeat:Connect(function()
        local c = LP.Character
        if not c then return end
        local t = c:FindFirstChildOfClass("Tool")
        if t then pcall(function() t:Activate() end) end
    end))
end

local function startAutoSkill()
    addConn(RunService.Heartbeat:Connect(function()
        local vim = game:GetService("VirtualInputManager")
        local keys = {Enum.KeyCode.Q, Enum.KeyCode.E, Enum.KeyCode.R, Enum.KeyCode.F}
        for _, k in ipairs(keys) do
            pcall(function()
                vim:SendKeyEvent(true, k, false, game)
                task.wait(0.05)
                vim:SendKeyEvent(false, k, false, game)
            end)
        end
    end))
end

local function startKillAura()
    addConn(RunService.Heartbeat:Connect(function()
        local r = getRoot()
        if not r then return end
        for _, e in ipairs(getEnemies()) do
            if (e.root.Position - r.Position).Magnitude < 25 then
                pcall(function()
                    local rem = game:GetService("ReplicatedStorage"):FindFirstChild("DamageEvent")
                    if rem then rem:FireServer(e.model, 9999) end
                end)
            end
        end
    end))
end

local function startAutoDodge()
    addConn(RunService.Heartbeat:Connect(function()
        local r, h = getRoot(), getHumanoid()
        if not r or not h then return end
        if h.Health < h.MaxHealth * 0.35 then
            h:ChangeState(Enum.HumanoidStateType.Jumping)
            r.Velocity = r.Velocity + Vector3.new(math.random(-20,20), 0, math.random(-20,20))
        end
    end))
end

local function startAutoFarm()
    addConn(RunService.Heartbeat:Connect(function()
        local r = getRoot()
        if not r then return end
        local target = getNearestEnemy(200)
        if target then
            local angle = tick() * 1.5
            local offset = Vector3.new(math.cos(angle)*12, 3, math.sin(angle)*12)
            r.CFrame = CFrame.new(target.root.Position + offset, target.root.Position)
            local t = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
            if t then pcall(function() t:Activate() end) end
        end
    end))
end

local function findUIButton(names)
    for _, g in ipairs(LP.PlayerGui:GetDescendants()) do
        if g:IsA("TextButton") or g:IsA("ImageButton") then
            for _, n in ipairs(names) do
                if string.find(string.lower(g.Name), string.lower(n)) then return g end
            end
        end
    end
    return nil
end

local function startAutoStart()
    addConn(RunService.Heartbeat:Connect(function()
        local b = findUIButton({"start", "play", "begin", "enter"})
        if b then pcall(function() b:Activate() end) end
    end))
end

local function startAutoReplay()
    addConn(RunService.Heartbeat:Connect(function()
        local b = findUIButton({"replay", "again", "restart", "retry"})
        if b then pcall(function() b:Activate() end) end
    end))
end

local function startAutoBackLobby()
    addConn(RunService.Heartbeat:Connect(function()
        local b = findUIButton({"lobby", "hub", "town", "back"})
        if b then pcall(function() b:Activate() end) end
    end))
end

local function startAutoEquip()
    addConn(RunService.Heartbeat:Connect(function()
        local inv = LP:FindFirstChild("Inventory") or LP:FindFirstChild("Backpack")
        if inv then
            local best, bestScore = nil, 0
            for _, i in ipairs(inv:GetChildren()) do
                if i:IsA("Tool") then
                    local s = #i.Name
                    if s > bestScore then bestScore = s; best = i end
                end
            end
            if best then pcall(function() best.Parent = LP.Character end) end
        end
    end))
end

local function startAutoSell()
    addConn(RunService.Heartbeat:Connect(function()
        local b = findUIButton({"sell", "sell all", "dispose"})
        if b then pcall(function() b:Activate() end) end
    end))
end

-- wiring
makeSection("Combat")
makeToggle("Auto Farm", false, function(v) State.AutoFarm = v; if v then startAutoFarm() else clearConnections() end end)
makeToggle("Auto Attack", false, function(v) State.AutoAttack = v; if v then startAutoAttack() end end)
makeToggle("Auto Skill", false, function(v) State.AutoSkill = v; if v then startAutoSkill() end end)
makeToggle("Kill Aura", false, function(v) State.KillAura = v; if v then startKillAura() end end)
makeToggle("Auto Dodge", false, function(v) State.AutoDodge = v; if v then startAutoDodge() end end)

makeSection("Dungeon")
makeToggle("Auto Start", false, function(v) State.AutoStart = v; if v then startAutoStart() end end)
makeToggle("Auto Replay", false, function(v) State.AutoReplay = v; if v then startAutoReplay() end end)
makeToggle("Auto Back Lobby", false, function(v) State.AutoBackLobby = v; if v then startAutoBackLobby() end end)

makeSection("Inventory")
makeToggle("Auto Equip Best", false, function(v) State.AutoEquip = v; if v then startAutoEquip() end end)
makeToggle("Auto Sell", false, function(v) State.AutoSell = v; if v then startAutoSell() end end)

makeSection("Movement")
makeToggle("Anti-AFK", false, function(v) State.AntiAFK = v; if v then enableAntiAFK() end end)
makeToggle("WalkSpeed", false, function(v)
    State.WalkSpeed = v
    if v then addConn(RunService.Heartbeat:Connect(function() applyWalkSpeed(120) end)) else applyWalkSpeed(16) end
end)
makeToggle("Infinite Jump", false, function(v) State.InfiniteJump = v; if v then enableInfiniteJump() end end)
makeToggle("NoClip", false, function(v) State.NoClip = v; if v then enableNoClip() end end)
makeToggle("Fly", false, function(v)
    State.Fly = v
    if v then enableFly() elseif Threads.FlyCleanup then Threads.FlyCleanup() end
end)

makeSection("Visual")
makeToggle("ESP", false, function(v)
    State.ESP = v
    if v then enableESP() else
        for _, d in pairs(espCache) do
            if d.billboard then d.billboard:Destroy() end
            if d.highlight then d.highlight:Destroy() end
        end
        espCache = {}
    end
end)
makeToggle("God Mode", false, function(v) State.GodMode = v; if v then enableGodMode() end end)

makeSection("Actions")
makeButton("Teleport to Nearest", teleportToNearest)
makeButton("Clear All Connections", function()
    clearConnections()
    for _, t in pairs(Toggles) do t.set(false) end
    applyWalkSpeed(16)
end)

LP.CharacterAdded:Connect(function()
    task.wait(1)
    if State.WalkSpeed then applyWalkSpeed(120) end
end)

if UserInputService.TouchEnabled then
    MainFrame.Size = UDim2.new(0, 300, 0, 460)
end

return true
