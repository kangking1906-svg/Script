local function enableInfiniteJump(token)
    addConn(UserInputService.JumpRequest:Connect(function()
        if not isCurrent("Jump", token) then return end
        local h = getHumanoid()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end))
