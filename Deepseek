local function findUIButton(names)
    for _, g in ipairs(LP.PlayerGui:GetDescendants()) do
        if g:IsA("TextButton") or g:IsA("ImageButton") then
            local n = g.Name:lower()
            for _, want in ipairs(names) do
                if n:find(want) then
                    -- visible + active check
                    if g.Visible and g.Active then return g end
                end
            end
        end
    end
    return nil
end

local function startAutoStart(token)
    task.spawn(function()
