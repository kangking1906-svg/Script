local function enableNoClip(token)
    addConn(RunService.Stepped:Connect(function()
        if not isCurrent("Clip", token) then return end
        local c = LP.Character
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end))
end

local function enableFly(token)
    local root, hum = getRoot(), getHumanoid()
    if not root or not hum then return end
    local bv = Instance.new("BodyVelocity", root)
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    local bg = Instance.new("BodyGyro", root)
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.P = 1e4
    addConn(RunService.RenderStepped:Connect(function()
        if not isCurrent("Fly", token) then return end
        local move = Vector3.zero
        local cam = Camera.CFrame
        local gp = UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)
        if gp then
            for _, i in ipairs(gp) do
                if i.KeyCode == Enum.KeyCode.Thumbstick1 then
                    move = move + cam.LookVector * i.Position.Z * 60
                    move = move + cam.RightVector * i.Position.X * 60
                end
            end
        end
        bv.Velocity = move
        bg.CFrame = cam
    end))
    Threads.FlyCleanup = function()
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
    end
end

local function teleportToNearest()
    local t = getNearestEnemy(9999)
    local r = getRoot()
    if t and r then r.CFrame = t.root.CFrame + Vector3.new(0, 3, 0) end
end

