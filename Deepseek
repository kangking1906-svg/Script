end)
makeToggle("Infinite Jump", false, function(v)
    State.InfiniteJump = v
    if v then enableInfiniteJump(newToken("Jump")) end
end)
makeToggle("NoClip", false, function(v)
    State.NoClip = v
    if v then enableNoClip(newToken("Clip")) end
end)
makeToggle("Fly", false, function(v)
    State.Fly = v
    if v then enableFly(newToken("Fly")) elseif Threads.FlyCleanup then Threads.FlyCleanup(); Threads.FlyCleanup = nil end
end)

makeSection("Visual")
makeToggle("ESP", false, function(v)
    State.ESP = v
    if v then enableESP(newToken("ESP")) else clearESP() end
end)
makeToggle("God Mode", false, function(v)
    State.GodMode = v
    if v then enableGodMode(newToken("God")) end
end)

makeSection("Actions")
makeButton("Teleport to Nearest", teleportToNearest)
makeButton("Clear All Connections", function()
    clearConnections()
    for _, t in pairs(Toggles) do t.set(false) end
    applyWalkSpeed(16)
end)

LP.CharacterAdded:Connect(function()
    task.wait(1)
    if State.WalkSpeed then applyWalkSpeed(120) end
end)

if UserInputService.TouchEnabled then
    MainFrame.Size = UDim2.new(0, 300, 0, 460)
end

return true
