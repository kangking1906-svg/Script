-- ============================================================
local function findButton(patterns)
    for _, g in ipairs(LP.PlayerGui:GetDescendants()) do
        if (g:IsA("TextButton") or g:IsA("ImageButton")) and g.Visible and g.Active then
            local n = g.Name:lower()
            local lbl = g:FindFirstChildOfClass("TextLabel")
            local txt = lbl and lbl.Text:lower() or ""
            for _, pat in ipairs(patterns) do
                if n:find(pat) or txt:find(pat) then return g end
            end
        end
    end
    return nil
end

local function inventoryRun(isAlive)
    while isAlive() do
        if State.AutoEquip then
            local inv = LP:FindFirstChild("Inventory") or LP:FindFirstChild("Backpack")
            if inv then
                local best, bestS = nil, 0
                for _, i in ipairs(inv:GetChildren()) do
                    if i:IsA("Tool") then
                        local s = 0
                        for _, a in ipairs({"Damage","Power","Level","Score","Rarity"}) do
                            local v = i:GetAttribute(a)
                            if type(v) == "number" and v > s then s = v end
                        end
                        if s == 0 then s = #i.Name end
                        if s > bestS then bestS = s; best = i end
                    end
                end
                if best and best.Parent ~= LP.Character then
                    pcall(function() best.Parent = LP.Character end)
                end
            end
        end
        if State.AutoSell then
            local b = findButton({"sell all","sellall","dispose all","quick sell"})
            if b then pcall(function() b:Activate() end) end
        end
        task.wait(2 + math.random())
    end
end

local function dungeonRun(isAlive)
    while isAlive() do
        if State.AutoStart then
            local b = findButton({"start","begin","enter","play"})
            if b then pcall(function() b:Activate() end) end
        end
        if State.AutoReplay then
            local b = findButton({"replay","again","restart","retry","next"})
            if b then pcall(function() b:Activate() end) end
        end
        if State.AutoBackLobby then
            local b = findButton({"lobby","hub","town","back","exit"})
            if b then pcall(function() b:Activate() end) end
        end
        task.wait(1.5 + math.random())
    end
end

-- ============================================================
-- MOVEMENT
-- ============================================================
local flyHover = nil
local function enableFlyHover()
    local r = getRoot()
    if not r then return end
    local bv = INew("BodyVelocity", r)
    bv.MaxForce = Vector3.new(1e5,1e5,1e5); bv.Velocity = Vector3.zero
    local bg = INew("BodyGyro", r)
    bg.MaxTorque = Vector3.new(1e5,1e5,1e5); bg.P = 1e4
    local conn = RunService.RenderStepped:Connect(function()
        if not State.Fly then return end
        local cam = Camera.CFrame
        local move = Vector3.zero
        local gp = UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)
        if gp then
            for _, i in ipairs(gp) do
                if i.KeyCode == Enum.KeyCode.Thumbstick1 then
                    move = move + cam.LookVector * i.Position.Z * 60
                    move = move + cam.RightVector * i.Position.X * 60
                end
            end
        end
        bv.Velocity = move
        bg.CFrame = cam
    end)
    flyHover = function()
        pcall(function() conn:Disconnect() end)
        pcall(function() bv:Destroy() end)
        pcall(function() bg:Destroy() end)
    end
end
local function disableFlyHover()
    if flyHover then flyHover(); flyHover = nil end
end

