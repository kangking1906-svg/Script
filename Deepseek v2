-- ============================================================
-- PERCEPTION
-- ============================================================
local cachedContainer, containerRescanAt = nil, 0
local function findContainer()
    local now = tick()
    if cachedContainer and cachedContainer.Parent and now < containerRescanAt then
        return cachedContainer
    end
    for _, name in ipairs({"Enemies","Mobs","Monsters","NPCs","Units","DungeonMobs","DungeonEnemies","Spawns","ActiveEnemies","WaveEnemies","Bosses","Hostiles"}) do
        local f = workspace:FindFirstChild(name)
        if f then cachedContainer = f; containerRescanAt = now + 10; return f end
    end
    for _, f in ipairs(workspace:GetChildren()) do
        if f:IsA("Folder") or f:IsA("Model") then
            for _, d in ipairs(f:GetChildren()) do
                if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") then
                    cachedContainer = f; containerRescanAt = now + 10; return f
                end
            end
        end
    end
    cachedContainer = workspace; containerRescanAt = now + 3
    return workspace
end

local function getEnemies()
    local out = {}
    local myChar = LP.Character
    for _, obj in ipairs(findContainer():GetDescendants()) do
        if obj:IsA("Model") and obj ~= myChar then
            local h = obj:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                local r = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChild("Torso")
                if r then out[#out+1] = {model=obj, humanoid=h, root=r} end
            end
        end
    end
    return out
end

local function getNearest(maxDist)
    local mr = getRoot()
    if not mr then return nil end
    local best, bestD = nil, maxDist or math.huge
    for _, e in ipairs(getEnemies()) do
        local d = (e.root.Position - mr.Position).Magnitude
        if d < bestD then bestD = d; best = e end
    end
    return best, bestD
end

local function getIncoming(radius)
    local mr = getRoot()
    if not mr then return {} end
    local out = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            for _, pat in ipairs({"projectile","bullet","arrow","orb","spell","fireball","bolt"}) do
                if n:find(pat) then
                    local d = (obj.Position - mr.Position).Magnitude
                    if d <= radius then
                        local v = obj.AssemblyLinearVelocity
                        if v.Magnitude > 8 then
                            out[#out+1] = {part=obj, vel=v, dist=d}
                        end
                    end
                    break
                end
            end
        end
    end
    return out
end

-- ============================================================
-- NAV (walking, no teleport)
-- ============================================================
local lastPos, stuckSince = Vector3.zero, 0
local function walkTo(p)
    local h = getHum()
    if h then h:MoveTo(p) end
end
local function detectStuck()
    local r = getRoot()
    if not r then return false end
    local moved = (r.Position - lastPos).Magnitude
    lastPos = r.Position
    if moved < 0.5 then
        if stuckSince == 0 then stuckSince = tick() end
        if tick() - stuckSince > 1.2 then stuckSince = 0; return true end
    else
        stuckSince = 0
    end
    return false
end

-- ============================================================
-- FLY-FARM (hover above enemy, out of melee reach)
-- ============================================================
local FlyFarm = {bv=nil, bg=nil, alt=22, standoff=6}
local function flyStart()
    local r = getRoot()
    if not r then return end
    if FlyFarm.bv then FlyFarm.bv:Destroy() end
    if FlyFarm.bg then FlyFarm.bg:Destroy() end
    local bv = INew("BodyVelocity", r)
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6); bv.P = 5000; bv.Velocity = Vector3.zero
    local bg = INew("BodyGyro", r)
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6); bg.P = 8000; bg.D = 500
    bg.CFrame = r.CFrame
    FlyFarm.bv, FlyFarm.bg = bv, bg
end
local function flyStop()
    if FlyFarm.bv then pcall(function() FlyFarm.bv:Destroy() end); FlyFarm.bv = nil end
    if FlyFarm.bg then pcall(function() FlyFarm.bg:Destroy() end); FlyFarm.bg = nil end
end
local function flyTick()
    local r = getRoot()
    if not r or not FlyFarm.bv then return end
    local target = getNearest(300)
    local desired
    if target then
        local base = target.root.Position
        local dx, dz = r.Position.X - base.X, r.Position.Z - base.Z
        local mag = math.sqrt(dx*dx + dz*dz)
        if mag < 0.1 then dx, dz, mag = 1, 0, 1 end
        desired = Vector3.new(base.X + (dx/mag) * FlyFarm.standoff, base.Y + FlyFarm.alt, base.Z + (dz/mag) * FlyFarm.standoff)
        FlyFarm.bg.CFrame = CFrame.lookAt(r.Position, Vector3.new(base.X, base.Y, base.Z))
    else
        desired = r.Position
    end
    local delta = desired - r.Position
    local horiz = Vector3.new(delta.X, 0, delta.Z) * 3
    local vert  = math.clamp(delta.Y * 4, -80, 80)
    local cur = r.AssemblyLinearVelocity or Vector3.zero
    FlyFarm.bv.Velocity = horiz + Vector3.new(0, vert - cur.Y * 0.6, 0)
end

-- ============================================================
-- CLICK (3-path activation)
-- ============================================================
local Clicker = {remote=nil, scanAt=0}
local function screenCenter()
    local vp = Camera.ViewportSize
    return Vec2New(vp.X * 0.5, vp.Y * 0.5)
end
local function scanRemote(tool)
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then return d end
    end
    return nil
end
local function click()
    local tool = getTool()
    if not tool then return end
    pcall(function() tool:Activate() end)
    local now = tick()
    if not Clicker.remote or now > Clicker.scanAt then
        Clicker.remote = scanRemote(tool); Clicker.scanAt = now + 20
    end
    if Clicker.remote then
        pcall(function()
            if Clicker.remote:IsA("RemoteEvent") then Clicker.remote:FireServer()
            elseif Clicker.remote:IsA("RemoteFunction") then Clicker.remote:InvokeServer() end
        end)
    end
    local p = screenCenter()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(p.X, p.Y, 0, true,  game, 0)
        task.wait(0.02 + math.random() * 0.02)
        VirtualInputManager:SendMouseButtonEvent(p.X, p.Y, 0, false, game, 0)
    end)
end

