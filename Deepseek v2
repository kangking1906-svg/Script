-- ATTACK LOOP
-- ============================================================
local function attackRun(isAlive)
    while isAlive() do
        if State.AutoAttack and getHum() and getHum().Health > 0 then
            click()
        end
        task.wait(0.22 + math.random() * 0.16)
    end
end

-- ============================================================
-- FARM LOOP (fly-hover mode or walk mode)
-- ============================================================
local function farmRun(isAlive)
    while isAlive() do
        if State.AutoFarm and getHum() and getHum().Health > 0 then
            if State.FlyFarm then
                if not FlyFarm.bv then flyStart() end
                flyTick()
            else
                if FlyFarm.bv then flyStop() end
                local r = getRoot()
                if r then
                    local target = getNearest(300)
                    if target then
                        local dist = (target.root.Position - r.Position).Magnitude
                        if dist > 7.5 then
                            walkTo(target.root.Position)
                        else
                            getHum():MoveTo(r.Position)
                            local flat = Vector3.new(target.root.Position.X, r.Position.Y, target.root.Position.Z)
                            if (flat - r.Position).Magnitude > 0.1 then
                                r.CFrame = CFrame.new(r.Position, flat)
                            end
                        end
                    else
                        getHum():MoveTo(r.Position)
                    end
                    if detectStuck() then
                        walkTo(r.Position + Vector3.new(math.random(-8,8), 0, math.random(-8,8)))
                        task.wait(0.4)
                    end
                end
            end
        else
            if FlyFarm.bv then flyStop() end
        end
        task.wait(0.15)
    end
    flyStop()
end

-- ============================================================
-- AURA
-- ============================================================
local function auraRun(isAlive)
    while isAlive() do
        if State.KillAura and getHum() and getHum().Health > 0 then
            local r = getRoot()
            if r then
                for _, e in ipairs(getEnemies()) do
                    if (e.root.Position - r.Position).Magnitude < 22 then
                        click()
                    end
                end
            end
        end
        task.wait(0.22 + math.random() * 0.1)
    end
end

-- ============================================================
-- DODGE
-- ============================================================
local function dodgeRun(isAlive)
    local last = 0
    while isAlive() do
        if State.AutoDodge and getHum() and getHum().Health > 0 then
            local now = tick()
            if now - last > 0.35 then
                local r, h = getRoot(), getHum()
                if r and h then
                    if h.Health < h.MaxHealth * 0.42 then
                        local away = (r.Position - Camera.CFrame.Position).Unit * 20
                        walkTo(r.Position + Vector3.new(away.X, 0, away.Z))
                        last = now
                    else
                        for _, p in ipairs(getIncoming(40)) do
                            local toMe = (r.Position - p.part.Position).Unit
                            if toMe:Dot(p.vel.Unit) > 0.65 then
                                local side = Vector3.new(-p.vel.Unit.Z, 0, p.vel.Unit.X)
                                if math.random() < 0.5 then side = -side end
                                walkTo(r.Position + side * 22)
                                last = now
                                break
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end

