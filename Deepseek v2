-- SKILL FSM (single-flight)
-- ============================================================
local Skill = {slots={"Q","E"}, cd={Q=3.5, E=6.0}, last={Q=0, E=0}, inFlight=false, flightDur=0.55}
local function skillPress(slot)
    local k = Enum.KeyCode[slot]
    if not k then return end
    Skill.inFlight = true
    local ok = pcall(function()
        VirtualInputManager:SendKeyEvent(true, k, false, game)
        task.wait(0.045 + math.random() * 0.02)
        VirtualInputManager:SendKeyEvent(false, k, false, game)
    end)
    task.spawn(function()
        task.wait(Skill.flightDur); Skill.inFlight = false
    end)
    if ok then Skill.last[slot] = tick() end
end
local function skillRun(isAlive)
    while isAlive() do
        if State.AutoSkill and getHum() and getHum().Health > 0 then
            local now = tick()
            if not Skill.inFlight then
                for _, slot in ipairs(Skill.slots) do
                    if (now - Skill.last[slot]) >= Skill.cd[slot] then
                        skillPress(slot); break
                    end
                end
            end
        end
        task.wait(0.1)
    end
end

