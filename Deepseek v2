local Scheduler = {tokens={}, threads={}}
function Scheduler.newToken(key)
    Scheduler.tokens[key] = (Scheduler.tokens[key] or 0) + 1
    local tok = Scheduler.tokens[key]
    if Scheduler.threads[key] then
        pcall(function() task.cancel(Scheduler.threads[key]) end)
        Scheduler.threads[key] = nil
    end
    return tok
end
function Scheduler.isCurrent(key, tok) return Scheduler.tokens[key] == tok end
function Scheduler.run(key, fn)
    local tok = Scheduler.newToken(key)
    Scheduler.threads[key] = task.spawn(function()
        fn(function() return Scheduler.isCurrent(key, tok) end)
    end)
    return tok
end
function Scheduler.stop(key)
    Scheduler.tokens[key] = (Scheduler.tokens[key] or 0) + 1
    if Scheduler.threads[key] then
        pcall(function() task.cancel(Scheduler.threads[key]) end)
        Scheduler.threads[key] = nil
    end
end

