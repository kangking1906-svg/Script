-- ESP
-- ============================================================
local espCache = {}
local function espRun(isAlive)
    while isAlive() do
        if State.ESP then
            for _, e in ipairs(getEnemies()) do
                local c = espCache[e.model]
                if not c or not c.bb or not c.bb.Parent then
                    local bb = INew("BillboardGui", e.model)
                    bb.Size = UDim2New(0, 110, 0, 32)
                    bb.StudsOffset = Vector3.new(0, 3.2, 0)
                    bb.AlwaysOnTop = true
                    local lbl = INew("TextLabel", bb)
                    lbl.Size = UDim2New(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.TextColor3 = FromRGB(255, 90, 90)
                    lbl.TextSize = 11
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextStrokeTransparency = 0
                    local hl = INew("Highlight", e.model)
                    hl.FillColor = FromRGB(255, 60, 60)
                    hl.OutlineColor = FromRGB(255, 255, 255)
                    hl.FillTransparency = 0.72
                    espCache[e.model] = {bb=bb, hl=hl, lbl=lbl}
                else
                    c.lbl.Text = string.format("%s [%d]", e.model.Name, math.floor(e.humanoid.Health))
                end
            end
        end
        task.wait(0.25)
    end
end
local function espClear()
    for _, d in pairs(espCache) do
        pcall(function() d.bb:Destroy() end)
        pcall(function() d.hl:Destroy() end)
    end
    espCache = {}
end

