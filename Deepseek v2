local function toggle(label, default, cb)
    local Btn = Create("TextButton", {
        Parent = Scroll,
        Size = UDim2New(1, 0, 0, 40),
        BackgroundColor3 = Theme.Element,
        Text = "",
        BorderSizePixel = 0,
        AutoButtonColor = false,
        ZIndex = 4,
    })
    Corner(Btn, 9)
    Stroke(Btn, Theme.Border, 0.92)
    local Lbl = Create("TextLabel", {
        Parent = Btn,
        Size = UDim2New(1, -72, 1, 0),
        Position = UDim2New(0, 14, 0, 0),
        BackgroundTransparency = 1,
        FontFace = FontFace,
        Text = label,
        TextColor3 = Theme.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local Track = Create("Frame", {
        Parent = Btn,
        Size = UDim2New(0, 42, 0, 22),
        Position = UDim2New(1, -54, 0.5, -11),
        BackgroundColor3 = default and Theme.Success or FromRGB(40,42,52),
        BorderSizePixel = 0,
    })
    Corner(Track, 11)
    local Dot = Create("Frame", {
        Parent = Track,
        Size = UDim2New(0, 16, 0, 16),
        Position = default and UDim2New(1, -18, 0.5, -8) or UDim2New(0, 2, 0.5, -8),
        BackgroundColor3 = FromRGB(228,230,240),
        BorderSizePixel = 0,
    })
    Corner(Dot, 8)
    local st = default or false
    local function set(v)
        st = v
        Tween(Track, nil, {BackgroundColor3 = st and Theme.Success or FromRGB(40,42,52)})
        Tween(Dot, nil, {Position = st and UDim2New(1,-18,0.5,-8) or UDim2New(0,2,0.5,-8)})
        if cb then cb(st) end
    end
    Btn.MouseButton1Click:Connect(function() set(not st) end)
    Btn.MouseEnter:Connect(function() Tween(Btn, nil, {BackgroundColor3 = Theme.Hover}) end)
    Btn.MouseLeave:Connect(function() Tween(Btn, nil, {BackgroundColor3 = Theme.Element}) end)
    Toggles[label] = {set=set, get=function() return st end}
end

local function button(label, cb)
    local Btn = Create("TextButton", {
        Parent = Scroll,
        Size = UDim2New(1, 0, 0, 36),
        BackgroundColor3 = Theme.Ghost,
        FontFace = FontFace,
        Text = label,
        TextColor3 = Theme.Text,
        TextSize = 12,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        ZIndex = 4,
    })
    Corner(Btn, 9)
    Stroke(Btn, Theme.Border, 0.92)
    Btn.MouseEnter:Connect(function() Tween(Btn, nil, {BackgroundColor3 = Theme.Hover}) end)
    Btn.MouseLeave:Connect(function() Tween(Btn, nil, {BackgroundColor3 = Theme.Ghost}) end)
    Btn.MouseButton1Click:Connect(cb)
end

