-- ===================== GOD MODE =====================
local GodConn
local function SetGodMode(state)
    Config.GodMode = state
    if GodConn then GodConn:Disconnect() end
    if state then
        GodConn = RunService.Heartbeat:Connect(function()
            local _, hum = GetChar()
            if hum then hum.Health = hum.MaxHealth end
        end)
    end
end

-- ===================== FLY =====================
local FlyBV, FlyBG
local function SetFly(state)
    Config.Fly = state
    local char, hum, root = GetChar()
    if not root then return end
    if state then
        FlyBV = Instance.new("BodyVelocity")
        FlyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        FlyBV.Velocity = Vector3.zero
        FlyBV.Parent = root
        FlyBG = Instance.new("BodyGyro")
        FlyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        FlyBG.P = 9e4
        FlyBG.Parent = root
        hum.PlatformStand = true
    else
        if FlyBV then FlyBV:Destroy() end
        if FlyBG then FlyBG:Destroy() end
        if hum then hum.PlatformStand = false end
    end
end

RunService.RenderStepped:Connect(function()
    local char, hum, root = GetChar()
    if not root or not hum then return end

    hum.WalkSpeed = Config.WalkSpeed

    if Config.Fly and FlyBV and FlyBG then
        local cam = workspace.CurrentCamera
        local move = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move + Vector3.new(0,-1,0) end
        FlyBV.Velocity = move.Magnitude > 0 and move.Unit * Config.FlySpeed or Vector3.zero
        FlyBG.CFrame = cam.CFrame
    end

    if Config.NoClip then
        for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

UserInputService.JumpRequest:Connect(function()
    if Config.InfiniteJump then
        local _, hum = GetChar()
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- ===================== ESP =====================
local ESPFolder = Instance.new("Folder", CoreGui)
ESPFolder.Name = "DQRESP"

local function ClearESP()
    ESPFolder:ClearAllChildren()
end

local function AddESP(part, name, color)
    local bill = Instance.new("BillboardGui")
    bill.Adornee = part
    bill.Size = UDim2.new(0, 120, 0, 30)
    bill.AlwaysOnTop = true
    bill.Parent = ESPFolder
    local lbl = Instance.new("TextLabel", bill)
    lbl.Size = UDim2.new(1,0,1,0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = color
    lbl.TextStrokeTransparency = 0.3
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 13
end

local function UpdateESP()
    ClearESP()
    if not Config.ESP then return end
    for _, m in pairs(workspace:GetDescendants()) do
        if m:IsA("Model") and m:FindFirstChild("Humanoid") and m:FindFirstChild("HumanoidRootPart") then
            if not Players:GetPlayerFromCharacter(m) and m.Humanoid.Health > 0 then
                local isBoss = m.Name:lower():find("boss")
                AddESP(m.HumanoidRootPart, m.Name .. " | " .. math.floor(m.Humanoid.Health), isBoss and Color3.fromRGB(255,140,0) or Color3.fromRGB(255,60,60))
            end
        end
    end
end

-- ===================== COMBAT =====================
local function GetNearest(range)
    local closest, dist = nil, range or 40
    local _, _, root = GetChar()
    if not root then return nil end
    for _, m in pairs(workspace:GetDescendants()) do
        if m:IsA("Model") and m:FindFirstChild("Humanoid") and m:FindFirstChild("HumanoidRootPart") then
            if not Players:GetPlayerFromCharacter(m) and m.Humanoid.Health > 0 then
                local d = (m.HumanoidRootPart.Position - root.Position).Magnitude
                if d < dist then
                    closest = m
                    dist = d
                end
            end
        end
    end
    return closest
end

local function Attack(target)
    if not target then return end
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
        local r = remotes:FindFirstChild("Attack") or remotes:FindFirstChild("Swing") or remotes:FindFirstChild("Damage")
        if r then r:FireServer(target) end
    end)
    VirtualUser:ClickButton1(Vector2.new())
end

RunService.Heartbeat:Connect(function()
    local _, _, root = GetChar()
    if not root then return end

    if Config.KillAura or Config.AutoAttack or Config.AutoFarm or Config.BossFarm then
        local target = GetNearest(Config.KillAura and Config.KillAuraRange or 45)
        if target then
            if Config.AutoFarm or Config.BossFarm then
                root.CFrame = CFrame.new(target.HumanoidRootPart.Position + Vector3.new(0, Config.FarmHeight, Config.FarmDistance))
            end
            if Config.AutoAttack or Config.KillAura then
                Attack(target)
            end
        end
    end

    if Config.AutoSkill then
        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
            for _, r in pairs(remotes:GetChildren()) do
                if r.Name:lower():find("skill") or r.Name:lower():find("ability") then
                    r:FireServer()
                end
            end
        end)
    end
end)

